{
  "name": "smart-student-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "MERN based Smart Student Management System for Teachers and Students with AI question & assessment generation, attendance analytics and WhatsApp alerts.",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "attendance:alerts": "npm run alerts --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mern",
    "student-management-system",
    "react",
    "express",
    "mongodb",
    "ai",
    "gemini",
    "openai",
    "whatsapp"
  ],
  "license": "MIT"
}
