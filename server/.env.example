# ---------------------------------------------------------------------------
# Smart Student Management System — server environment
# Copy to `server/.env` and fill in the values you need. Everything has a
# working default, so the app boots with no .env at all.
# ---------------------------------------------------------------------------

# ------------------------------- server -------------------------------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=*

# ------------------------------ database ------------------------------
# Point this at your local MongoDB (Compass / Atlas) to persist data.
# If Mongo is unreachable the API automatically falls back to a seeded
# in-memory demo store so the product is still fully explorable.
MONGO_URI=mongodb://127.0.0.1:27017/smart_student_ms
ALLOW_IN_MEMORY_FALLBACK=true
AUTO_SEED=true

# -------------------------------- auth --------------------------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Codes required when signing up from the public register page
TEACHER_INVITE_CODE=TEACH2024
STUDENT_CLASS_CODE=CLASS2024
SEED_PASSWORD_STUDENT=Student@123
SEED_PASSWORD_TEACHER=Teacher@123

# --------------------------- AI question engine ------------------------
# auto   -> use Gemini/OpenAI when a key exists, otherwise the built-in
#           offline template generator (default, works with no API key)
# gemini -> force Google Gemini
# openai -> force OpenAI
# local  -> always use the offline generator
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=45000

# ------------------------------- WhatsApp ------------------------------
# console -> log messages to the API console and alert history (default)
# twilio  -> send through the Twilio WhatsApp API
# meta    -> send through the Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=console
ATTENDANCE_THRESHOLD=75

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
